---
interface Props { name: string; postcode: string; slug: string }
const { name, postcode, slug } = Astro.props;
const query = encodeURIComponent(`${name} NSW ${postcode}`);
const preview = `/images/maps/${slug}.webp`;
const externalMap = `https://www.google.com/maps/search/?api=1&query=${query}`;
---
<div class="map-wrap">
  <div class="map-placeholder" data-map data-query={query} role="button" tabindex="0" aria-label={`Load interactive map of ${name} NSW ${postcode}`}>
    <img src={preview} width="800" height="500" loading="lazy" decoding="async" alt={`Street map preview centred on ${name} NSW ${postcode}`} />
    <div class="map-placeholder__prompt" data-map-prompt>
      <h2>{name} {postcode}</h2>
      <p>See the suburb first, then open the map for street-level detail.</p>
      <span class="map-placeholder__action" data-map-action>Explore Interactive Map</span>
    </div>
  </div>
  <p class="map-attribution">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>. <a href={externalMap} target="_blank" rel="noopener noreferrer">Open {name} in Google Maps</a>.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const action = map.querySelector<HTMLElement>('[data-map-action]');
    const loadMap = () => {
      if (map.dataset.mapLoaded === 'true') return;
      map.dataset.mapLoaded = 'true';
      map.setAttribute('aria-busy', 'true');
      const query = map.dataset.query;
      const iframe = document.createElement('iframe');
      iframe.title = `Interactive map of ${decodeURIComponent(query ?? '')}`;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.src = `https://www.google.com/maps?q=${query}&output=embed`;
      iframe.addEventListener('load', () => {
        map.classList.add('map-placeholder--loaded');
        map.removeAttribute('role');
        map.removeAttribute('tabindex');
        map.removeAttribute('aria-label');
        map.setAttribute('aria-busy', 'false');
      }, { once: true });
      map.append(iframe);
      if (action) action.textContent = 'Loading Interactive Map';
    };
    map.addEventListener('click', loadMap);
    map.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        loadMap();
      }
    });
  });
</script>
