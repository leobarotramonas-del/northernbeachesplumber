---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, services, site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const canonical = new URL(path, site.url).toString();
const published = post.data.publishDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.publishDate).toISOString();
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const schema = [
  { '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: post.data.title, description: post.data.description, datePublished: published, dateModified: modified, author: { '@type': 'Organization', name: post.data.author }, publisher: { '@id': `${site.url}/#business` }, mainEntityOfPage: { '@id': `${canonical}#webpage` }, ...(post.data.image ? { image: new URL(post.data.image, site.url).toString() } : {}) },
  { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` }, { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` }, { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical }] },
];
const relatedServices = (post.data.relatedServices ?? []).map((slug) => services.find((service) => service.slug === slug)).filter(Boolean);
const relatedAreas = (post.data.relatedSuburbs ?? []).map((slug) => areas.find((area) => area.slug === slug)).filter(Boolean);
---
<BaseLayout title={post.data.title} description={post.data.description} canonicalPath={path} schema={schema} image={post.data.image} pageType="article" publishedTime={published} modifiedTime={modified}>
  <article>
    <nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span aria-current="page">{post.data.title}</span></nav>
    <header class="article-header"><div class="wrap"><h1>{post.data.title}</h1><p class="article-header__description">{post.data.description}</p><div class="article-meta"><span>{post.data.category}</span><time datetime={published}>Published {formatDate(post.data.publishDate)}</time>{post.data.updatedDate && <time datetime={modified}>Updated {formatDate(post.data.updatedDate)}</time>}<span>By {post.data.author}</span></div></div></header>
    {post.data.image && <img class="article-image" src={post.data.image} width="1200" height="675" loading="eager" decoding="async" alt={post.data.imageAlt ?? ''} />}
    <div class="article-body"><Content /></div>
    {(relatedServices.length > 0 || relatedAreas.length > 0) && <aside class="article-related wrap" aria-labelledby="related-reading"><h2 id="related-reading">Related Local Information</h2><div>{relatedServices.map((service) => service && <a href={`/services/${service.slug}/`}>Explore {service.name} Services</a>)}{relatedAreas.map((area) => area && <a href={`/service-areas/${area.slug}/`}>Plumbing Services in {area.name}</a>)}</div></aside>}
  </article>
  <CtaBand title="Ask About a Plumbing Problem" />
</BaseLayout>
