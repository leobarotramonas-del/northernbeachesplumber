---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, services, site } from '../../data/site';
---
<BaseLayout title="Northern Beaches Plumbing Services | Antons" description="Explore licensed Northern Beaches plumbing, including blocked drains, hot water, repairs, gas fitting, leak detection and urgent plumbing help." canonicalPath="/services/">
  <nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Services</span></nav>
  <PageHero eyebrow="Northern Beaches plumbing" title="Plumbing Services for Homes and Properties" intro="Choose the service that best matches the symptoms. If you are unsure, call and explain what you can see, hear or smell so the team can guide the next step." image="/images/team-fleet-landscape.webp" imageSmall="/images/team-fleet-landscape-720.webp" imageAlt="Three Antons plumbers standing beside blue plumbing vehicles" />
  <section class="directory wrap"><div class="service-grid">{services.map((service) => <article class="service-card"><ResponsiveImage src={service.image} small={service.imageSmall} alt={service.alt} width={service.slug === 'blocked-drains' ? 720 : 900} height={service.slug === 'blocked-drains' ? 720 : 900} /><div class="service-card__body"><p class="service-card__label">{service.short}</p><h3>{service.name}</h3><p>{service.intro}</p><a href={`/services/${service.slug}/`}>Explore {service.name}</a></div></article>)}</div></section>
  <section class="content-section expertise-section" aria-labelledby="services-authority-title"><div class="wrap expertise-layout"><div><h2 id="services-authority-title">Why Northern Beaches Property Owners Choose Our Team</h2><p>The Northern Beaches Plumber is operated by Antons Enterprises Pty Ltd under NSW contractor licence {site.licence}. Customers can expect practical assessment, clear communication and a scope suited to the accessible system.</p></div><div class="expertise-list"><div><h3>Licensed Plumbing and Gas Work</h3><p>Regulated work is completed under the applicable NSW contractor licence.</p></div><div><h3>Diagnosis Suited to the Fault</h3><p>Inspection methods are selected according to the symptoms, accessible plumbing and agreed scope.</p></div><div><h3>Property-Aware Planning</h3><p>Access, parking, strata requirements and affected services are reviewed before the repair approach is agreed.</p></div></div></div></section>
  <section class="content-section process service-directory-process" aria-labelledby="service-process-title"><div class="wrap"><div class="section-heading"><h2 id="service-process-title">How We Assess and Complete Plumbing Work</h2><p>A consistent process helps move from the reported symptom to an informed repair decision without guessing at the cause.</p></div><div class="process-grid"><article class="process-step"><h3>Understand the Problem</h3><p>We confirm the affected fixtures, property type, access and any immediate safety concern.</p></article><article class="process-step"><h3>Inspect the System</h3><p>The plumber checks the accessible plumbing and uses suitable diagnostic equipment where needed.</p></article><article class="process-step"><h3>Explain the Options</h3><p>The findings, practical repair choices and proposed scope are discussed before work proceeds.</p></article><article class="process-step"><h3>Complete and Check</h3><p>Approved work is completed, the accessible system is checked and the outcome is explained.</p></article></div></div></section>
  <section class="content-section wrap" aria-labelledby="service-locations-title"><div class="section-heading"><h2 id="service-locations-title">Plumbing Services by Northern Beaches Suburb</h2><p>View local property, access and booking information for each suggested service area.</p></div><div class="card-list">{areas.map((area) => <a class="route-card" href={`/service-areas/${area.slug}/`}><span class="route-card__label">NSW {area.postcode}</span><h3>{area.name}</h3><p>Explore plumbing services and local guidance for {area.name}.</p></a>)}</div></section>
  <CtaBand />
</BaseLayout>


