---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import GoogleRating from '../components/GoogleRating.astro';
import AvailabilityStatus from '../components/AvailabilityStatus.astro';
import { areas, homeFaqs, reviews, services, site } from '../data/site';

const title = 'Northern Beaches Plumber | Licensed Local Plumbing';
const description = 'Licensed Northern Beaches plumbers for blocked drains, hot water, leaks, gas fitting and household repairs. Call Antons on 0493 824 176.';
const faqSchema = { '@type': 'FAQPage', '@id': `${site.url}/#faq`, mainEntity: homeFaqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---
<BaseLayout title={title} description={description} canonicalPath="/" schema={[faqSchema]} image="/images/service-truck-action.webp" imageAlt="Antons plumber preparing equipment on a blue plumbing service vehicle">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__grid wrap">
      <div class="home-hero__copy">
        <h1 id="home-title"><span>The Northern Beaches’</span><span>Local Plumber</span></h1>
        <p class="home-hero__lede">Clear advice, licensed plumbing and practical next steps for homes and properties across Sydney’s Northern Beaches.</p>
        <div class="home-hero__trust"><GoogleRating /><AvailabilityStatus /></div>
        <div class="home-hero__actions"><a class="button button--blue" href={site.phoneHref}>Call {site.phoneDisplay}</a><a class="button button--ghost" href="/services/">Explore Our Services</a></div>
        <p class="licence-line">Operated by {site.operator} · NSW licence {site.licence}</p>
      </div>
      <div class="home-hero__media">
        <video muted loop playsinline preload="none" poster="/images/service-truck-action.webp" width="720" height="900" aria-label="Antons plumbing team at work">
          <source data-src="/media/northern-beaches-hero.mp4" type="video/mp4" />
        </video>
        <button class="video-toggle" type="button" aria-label="Play hero video"><span aria-hidden="true">Play</span></button>
      </div>
    </div>
  </section>

  <section class="local-strip"><div class="local-strip__inner wrap"><div><h2>Need a Northern Beaches Local Plumber?</h2><p>Tell us the address, property type and what is happening.</p></div><a class="button button--blue" href={site.phoneHref}>Call {site.phoneDisplay}</a></div></section>

  <section class="home-section wrap" aria-labelledby="services-title">
    <div class="section-heading"><h2 id="services-title"><span>Local Plumbing Help</span><span>Across the Northern Beaches</span></h2><p>Choose the service that best matches what is happening at your Northern Beaches home, unit or managed property. Each guide explains what to look for, how the problem is assessed and what to expect when work is arranged.</p></div>
    <div class="service-grid">{services.map((service) => <article class="service-card"><ResponsiveImage src={service.image} small={service.imageSmall} alt={service.alt} width={1440} height={900} /><div class="service-card__body"><span class="service-card__label">{service.short}</span><h3>{service.name}</h3><p>{service.intro}</p><a href={`/services/${service.slug}/`}>Explore {service.name} Services</a></div></article>)}</div>
  </section>

  <section class="experience"><div class="experience__grid wrap"><ResponsiveImage src="/images/team-portrait.webp" small="/images/team-portrait-720.webp" width={1440} height={960} alt="Three Antons plumbers standing in front of a blue service vehicle" /><div><h2>Your Northern Beaches Plumbing Team</h2><p>Operated by Antons Enterprises Pty Ltd, the licensed team helps Northern Beaches homes and properties with blocked drains, hot water systems, plumbing repairs, gas fitting and leak detection. We assess the reported symptoms, explain practical options and agree on the scope before work begins.</p><p class="operator-line">NSW contractor licence {site.licence}</p><a class="button button--blue" href="/about/">Meet the Plumbing Team</a></div></div></section>

  <section class="home-section wrap" aria-labelledby="areas-title"><div class="section-heading"><h2 id="areas-title">Northern Beaches Service Areas</h2><p>Explore the suburbs currently listed in our service guide. Call with the complete address so coverage and availability can be confirmed before a visit is booked.</p></div><div class="area-grid">{areas.map((area) => <a class="area-card" href={`/service-areas/${area.slug}/`}><span>NSW {area.postcode}</span><h3>{area.name}</h3><p>Plumbing services and property guidance</p></a>)}</div><a class="text-link" href="/service-areas/">View All Northern Beaches Service Areas</a></section>

  <section class="home-section process" aria-labelledby="process-title"><div class="wrap"><div class="section-heading"><h2 id="process-title">How Our Plumbing Service Works</h2><p>A straightforward process moves from the reported symptom to an agreed next step.</p></div><div class="process-grid"><article class="process-step"><span>1</span><h3>Tell Us the Problem</h3><p>Share the address, affected fixtures and any immediate safety concern.</p></article><article class="process-step"><span>2</span><h3>Plan Access</h3><p>We review parking, strata, pets and equipment access where relevant.</p></article><article class="process-step"><span>3</span><h3>Assess the Cause</h3><p>The plumber inspects accessible plumbing and explains the practical options.</p></article><article class="process-step"><span>4</span><h3>Complete Agreed Work</h3><p>Approved repairs proceed and the outcome is checked and explained.</p></article></div></div></section>

  <section class="home-section reviews" id="reviews" aria-labelledby="reviews-title"><review-carousel class="wrap"><div class="section-heading"><h2 id="reviews-title">Genuine Customer Feedback</h2><p>These are concise summaries of customer feedback, not direct quotations. Follow the source link to review the published feedback and attribution.</p></div><div class="review-controls"><button type="button" data-prev aria-label="Previous feedback"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg></button><button type="button" data-next aria-label="Next feedback"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></svg></button></div><div class="review-track" data-track tabindex="0" aria-label="Customer feedback summaries">{reviews.map((review) => <figure><blockquote>{review.text}</blockquote><figcaption>{review.name}<br /><a href={site.reviewSourceUrl} target="_blank" rel="noopener noreferrer">Read the source page</a></figcaption></figure>)}</div></review-carousel></section>

  <FaqSection faqs={homeFaqs} title="Northern Beaches Plumbing Questions" />
  <CtaBand title="Talk to a Northern Beaches Plumber" />

  <script>
    const video = document.querySelector<HTMLVideoElement>('.home-hero video');
    const source = video?.querySelector<HTMLSourceElement>('source[data-src]');
    const toggle = document.querySelector<HTMLButtonElement>('.video-toggle');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const loadVideo = () => { if (video && source?.dataset.src) { source.src = source.dataset.src; source.removeAttribute('data-src'); video.load(); } };
    const setToggle = (playing: boolean) => { if (!toggle) return; toggle.textContent = playing ? 'Pause' : 'Play'; toggle.setAttribute('aria-label', playing ? 'Pause hero video' : 'Play hero video'); };
    const playVideo = async () => { if (!video || reduced) return; loadVideo(); try { await video.play(); setToggle(true); } catch { setToggle(false); } };
    if (!reduced) window.addEventListener('load', () => window.setTimeout(() => void playVideo(), 1200), { once: true });
    toggle?.addEventListener('click', () => { if (!video) return; if (video.paused) void playVideo(); else { video.pause(); setToggle(false); } });
    class ReviewCarousel extends HTMLElement {
      connectedCallback() { const track = this.querySelector<HTMLElement>('[data-track]'); const prev = this.querySelector<HTMLButtonElement>('[data-prev]'); const next = this.querySelector<HTMLButtonElement>('[data-next]'); const move = (direction: number) => track?.scrollBy({ left: direction * (track.clientWidth * .9), behavior: reduced ? 'auto' : 'smooth' }); prev?.addEventListener('click', () => move(-1)); next?.addEventListener('click', () => move(1)); }
    }
    if (!customElements.get('review-carousel')) customElements.define('review-carousel', ReviewCarousel);
  </script>
</BaseLayout>
