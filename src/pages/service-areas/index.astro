---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, services } from '../../data/site';
---
<BaseLayout title="Northern Beaches Plumber Service Areas | Antons" description="Find licensed plumbing services across the Northern Beaches, from Manly and Dee Why to Mona Vale, Newport, Avalon Beach and nearby suburbs." canonicalPath="/service-areas/" image="/images/fleet-lineup.webp" imageAlt="Four blue Antons plumbing service vehicles parked together">
  <nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Service Areas</span></nav>
  <PageHero eyebrow="Northern Beaches service areas" title="Plumbing Across the Northern Beaches" intro="Explore the suggested service areas below for blocked drains, hot water, leaks, gas fitting and repairs. Call with your full address to confirm current coverage." image="/images/fleet-lineup.webp" imageSmall="/images/fleet-lineup-720.webp" imageAlt="Four blue Antons plumbing service vehicles parked together" />
  <section class="directory wrap"><div class="card-list">{areas.map((area) => <a class="route-card" href={`/service-areas/${area.slug}/`}><span class="route-card__label">Northern Beaches · {area.postcode}</span><h2>{area.name}</h2><p>{area.intro}</p><strong>View Plumbing Services in {area.name}</strong></a>)}</div></section>
  <section class="content-section wrap" aria-labelledby="area-services-title"><div class="section-heading"><h2 id="area-services-title">Services Available Across Our Local Area</h2><p>Explore the plumbing service that best matches your symptoms, then call with the complete property address to confirm coverage and availability.</p></div><div class="card-list">{services.map((service) => <a class="route-card" href={`/services/${service.slug}/`}><span class="route-card__label">{service.short}</span><h3>{service.name}</h3><p>{service.intro}</p></a>)}</div></section>
  <CtaBand title="Check Your Northern Beaches Address" />
</BaseLayout>


