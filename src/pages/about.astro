---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
---
<BaseLayout title="About Antons | Northern Beaches Plumbing Team" description="Meet the licensed Antons team serving Northern Beaches homes and properties with drainage, hot water, gas, leak detection and plumbing repairs." canonicalPath="/about/" image="/images/team-fleet-wide.webp" imageAlt="Three Antons plumbers standing between blue service vehicles">
  <nav class="breadcrumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">About</span></nav>
  <PageHero eyebrow="The plumbing team" title="A Practical Team for Northern Beaches Plumbing" intro="The Northern Beaches Plumber is operated by Antons Enterprises Pty Ltd, bringing an established plumbing team to enquiries across the region." image="/images/team-fleet-wide.webp" imageSmall="/images/team-fleet-wide-720.webp" imageAlt="Three Antons plumbers standing between blue service vehicles" />
  <section class="content-section wrap"><div class="content-grid"><ResponsiveImage class="team-photo" src="/images/team-portrait.webp" small="/images/team-portrait-720.webp" width={1440} height={960} alt="Three Antons plumbers standing together in front of a blue service vehicle" /><div><h2>Plumbing Advice Grounded in the Actual Job</h2><p>The team starts with what is happening at the property, checks the accessible plumbing and explains the practical next step. We avoid unsupported promises about arrival times, prices or causes before the job details are understood.</p><p><strong>Operator:</strong> {site.operator}<br /><strong>NSW contractor licence:</strong> {site.licence}<br /><strong>Service area:</strong> Northern Beaches addresses confirmed when booking</p></div></div></section>
  <section class="content-section expertise-section"><div class="wrap expertise-layout"><div><h2>What Customers Can Expect</h2><p>Clear questions before the visit, practical assessment at the property and an explained scope before agreed work proceeds.</p></div><div class="expertise-list"><div><h3>Useful Preparation</h3><p>Address, property type, symptoms and access details are reviewed before attendance is arranged.</p></div><div><h3>Careful Assessment</h3><p>The plumber works from the visible symptoms and accessible services rather than guessing at the cause.</p></div><div><h3>Clear Handover</h3><p>The outcome, checks completed and any recommended follow-up are explained.</p></div></div></div></section>
  <CtaBand title="Talk With the Plumbing Team" />
</BaseLayout>


